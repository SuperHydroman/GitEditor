<Window x:Class="GidEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:GidEditor.Views.UserControls"
        mc:Ignorable="d"
        Title="Greetings" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <userControls:MenuBar Grid.Row="0" />
        
        <!-- Content panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="8*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Background="DarkGray">
            </Grid>
            
            <Grid Grid.Column="1" Background="Gray">
            </Grid>
            
            <Grid Grid.Column="2" Background="DarkGray">
            </Grid>
        </Grid>
        
        <!-- Footer -->
        <Rectangle Grid.Row="2" Fill="DimGray" />
    </Grid>
</Window>
